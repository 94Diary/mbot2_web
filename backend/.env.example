# เว็บเซิร์ฟเวอร์ (bind เฉพาะ loopback)
HOST=127.0.0.1
PORT=8000
MBOT2_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# ไฟล์ฐานข้อมูล SQLite (git ignore อยู่แล้ว)
MBOT2_DB_PATH=./data/mbot2.db
# workspace ของโค้ดหุ่น ที่ตัวสั่งซิมจะ build/launch
MBOT2_WS_PATH=/home/<user>/ros2_ws
MBOT2_SESSION_DAYS=7
MBOT2_BACKUP_DIR=./backups
